# Copie este arquivo para .env.local e preencha.
# Sem as duas variáveis do Supabase, o app roda em MODO DEMONSTRAÇÃO.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Livre (developers.mercadolivre.com.br > Minhas aplicações)
ML_APP_ID=
ML_APP_SECRET=
ML_REDIRECT_URI=http://localhost:3000/api/ml/callback

# Segredo que o agendador do Supabase manda pra rodar a conferência de preços.
# Gere um valor aleatório longo (ex.: openssl rand -hex 32).
CRON_SECRET=

# Telegram (crie o bot com o @BotFather)
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT=NomeDoSeuBot
TELEGRAM_WEBHOOK_SECRET=

# E-mail via Resend (opcional)
RESEND_API_KEY=
EMAIL_REMETENTE="Radar <avisos@seudominio.com.br>"

# Mercado Pago (Suas integrações > Credenciais de produção > Access Token)
MP_ACCESS_TOKEN=
