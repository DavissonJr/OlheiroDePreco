# Copie este arquivo para .env.local (no seu computador) e cole os mesmos
# valores em Settings > Environment Variables na hospedagem.
# Sem as duas variáveis NEXT_PUBLIC_SUPABASE_*, o app roda em MODO DEMONSTRAÇÃO.

# Endereço público do site, sem barra no final (ex.: https://olheirodepreco.com.br)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Quem responde pelo serviço e e-mail de contato (aparecem em Termos e Privacidade)
NEXT_PUBLIC_RESPONSAVEL=
NEXT_PUBLIC_CONTATO_EMAIL=

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Livre (developers.mercadolivre.com.br > Minhas aplicações)
ML_APP_ID=
ML_APP_SECRET=
ML_REDIRECT_URI=http://localhost:3000/api/ml/callback

# Segredo que o agendador do Supabase envia pra rodar a conferência de preços.
# Gere um valor aleatório longo (ex.: openssl rand -hex 32).
CRON_SECRET=

# Telegram (crie o bot com o @BotFather)
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT=OlheiroDePrecoBot
TELEGRAM_WEBHOOK_SECRET=

# E-mail dos avisos via Resend (opcional, mas recomendado)
RESEND_API_KEY=
EMAIL_REMETENTE="Olheiro de Preço <avisos@seudominio.com.br>"

# Mercado Pago (Suas integrações > Credenciais > Access Token)
MP_ACCESS_TOKEN=
